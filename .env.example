# Nothing here is required. On Vercel the site uses its *.vercel.app address automatically.

# Only if you add a custom domain later: its public URL (used for canonical links, sitemap, OpenGraph).
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional: n8n webhook that answers "Write me a brief" and "Hiring? Paste the role".
# When unset, the site answers locally by matching the brief against the casework.
# The webhook receives { text, mode } and should return { approach, cases: string[] }.
# N8N_BRIEF_WEBHOOK_URL=https://your-n8n-host/webhook/brief

# Optional: a shared secret sent as the X-Brief-Token header to the webhook above.
# N8N_BRIEF_TOKEN=
